# シークレットの雛形。`make env` で .secret.local にコピーされる。
# .secret.local はコミット禁止（.gitignore 済み）。ローカル開発限定で
# Secret Manager の代替として使う（本番・stg では Secret Manager を使う。NFR-12）。
# KEY=value 形式・引用符なし。エミュレータ利用のみなら全て空/ダミーで動作する。

# サーバ側HMAC（冪等キー・監査ハッシュ用。ローカルのダミー値で可）
SERVER_HMAC_SECRET=change-me-local-dev

# 内部ジョブ呼出しトークン（/v1/internal/jobs/*。エミュレータでは未設定でも動作。
# 本番は Cloud Tasks OIDC 等へ置き換える）
INTERNAL_JOB_TOKEN=dev-internal-job-token

# Google Places API キー（施設検索。未設定ならAPI側はモック/固定応答で実装すること）
GOOGLE_PLACES_API_KEY=

# LLM（医療情報の送信はリージョン・契約承認まで禁止。未設定なら固定質問フォールバック）
GEMINI_API_KEY=
LLM_MODEL_ID=

# Firebase Admin SDK（本番GCPへ接続する場合のみ。エミュレータでは不要）
# GOOGLE_APPLICATION_CREDENTIALS=
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY=
