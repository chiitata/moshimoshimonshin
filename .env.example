# 非シークレット環境変数の雛形。`make env` で .env.local にコピーされる。
# KEY=value 形式・引用符なし。機密値はここに書かず .secret.local を使うこと。

# Firebase プロジェクト（本番IDは moshimoshimonshin。ローカルはエミュレータ用ダミーID）
FIREBASE_PROJECT_ID=demo-mmr-dev

# App Check モード（enforce|permissive。エミュレータ時の既定は permissive）
# APP_CHECK_MODE=permissive

# API ドキュメント（Swagger UI /docs と OpenAPI /docs/json）の公開
# 既定: エミュレータ/非production は true、production は false
# API_DOCS_ENABLED=true

# API CORS 許可元（カンマ区切りの正確な origin。空なら許可なし）
# development の既定は localhost:5050 と 127.0.0.1:5050、production/test は許可なし。
# API_CORS_ORIGINS=http://localhost:5050,http://127.0.0.1:5050

# /healthz の Firestore 依存プローブ（既定: 2秒タイムアウト / 5秒キャッシュ）
# タイムアウト 1〜30000ms、キャッシュ 1〜60000ms。0 にすると起動しない
# （未認証経路の read 直撃防止）
# HEALTHZ_PROBE_TIMEOUT_MS=2000
# HEALTHZ_PROBE_CACHE_MS=5000

# ポート
API_PORT=8080
HOSPITAL_PORT=3000
PATIENT_WEB_PORT=5050
EMU_UI_PORT=4000

# Next.js 病院ポータル（ブラウザから見えるURLを書く）
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/v1
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-mmr-dev
NEXT_PUBLIC_USE_FIREBASE_EMULATOR=true

# 患者 Flutter Web 起動時の --dart-define（make up が flutter run に渡す）
PATIENT_DART_DEFINES=--dart-define=API_BASE_URL=http://localhost:8080/v1 --dart-define=USE_FIREBASE_EMULATOR=true --dart-define=FIREBASE_PROJECT_ID=demo-mmr-dev

TZ=Asia/Tokyo
